  "components" : {
    "schemas" : {
      "CreateHoldRequest" : {
        "type" : "object",
        "properties" : {
          "prisonNumber" : {
            "type" : "string",
            "description" : "The prison number as seen in services like DPS",
            "example" : "A1999EC"
          },
          "legacyHoldNumber" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The hold number as seen in NOMIS",
            "example" : 12345789
          },
          "subAccountRef" : {
            "type" : "string",
            "description" : "The sub account reference as seen in Prisoner Finance",
            "enum" : [ "CASH", "SPENDS", "SAVINGS" ],
            "example" : "CASH"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "The time the Hold was created",
            "example" : "2026-08-21T15:05:29.426237729Z"
          },
          "createdBy" : {
            "type" : "string",
            "description" : "The person who created the Hold",
            "example" : "2026-08-21T15:05:29.426237729Z"
          },
          "holdFromDate" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "The date that the hold is active from",
            "example" : "2026-08-21T15:05:29.426237729Z"
          },
          "holdUntilDate" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "The date that the hold is expected to be removed",
            "example" : "2026-08-21T15:05:29.426237729Z"
          },
          "isReleased" : {
            "type" : "boolean",
            "description" : "A boolean indicating whether the hold has been released",
            "example" : false
          },
          "description" : {
            "type" : [ "string", "null" ],
            "description" : "A description of the reason for the hold",
            "example" : "Damages to cell"
          },
          "holdType" : {
            "type" : "string",
            "description" : "The type of transaction that initiated the hold",
            "enum" : [ "HOA", "WHF" ],
            "example" : "WHF"
          },
          "amount" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The amount to hold from the sub account in pence",
            "example" : 1023
          },
          "holdLocation" : {
            "type" : "string",
            "description" : "The location of the hold as a prison code",
            "example" : "LEI"
          }
        },
        "required" : [ "amount", "createdAt", "createdBy", "holdFromDate", "holdLocation", "holdType", "isReleased", "legacyHoldNumber", "prisonNumber", "subAccountRef" ]
      },
      "HoldResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "prisonNumber" : {
            "type" : "string"
          },
          "legacyHoldNumber" : {
            "type" : "integer",
            "format" : "int64"
          },
          "subAccountRef" : {
            "type" : "string",
            "enum" : [ "CASH", "SPENDS", "SAVINGS" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "createdBy" : {
            "type" : "string"
          },
          "holdFromDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "holdUntilDate" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "isReleased" : {
            "type" : "boolean"
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "holdType" : {
            "type" : "string",
            "enum" : [ "HOA", "WHF" ]
          },
          "amount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "holdLocation" : {
            "type" : "string"
          }
        },
        "required" : [ "amount", "createdAt", "createdBy", "holdFromDate", "holdLocation", "holdType", "id", "isReleased", "legacyHoldNumber", "prisonNumber", "subAccountRef" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "errorCode" : {
            "type" : [ "string", "null" ]
          },
          "userMessage" : {
            "type" : [ "string", "null" ]
          },
          "developerMessage" : {
            "type" : [ "string", "null" ]
          },
          "moreInfo" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "status" ]
      },
      "ReleaseHoldRequest" : {
        "type" : "object",
        "properties" : {
          "releaseDateTime" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "releaseDateTime" ]
      },
      "ReleasedHoldResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "prisonNumber" : {
            "type" : "string"
          },
          "subAccountRef" : {
            "type" : "string",
            "enum" : [ "CASH", "SPENDS", "SAVINGS" ]
          },
          "amountReleased" : {
            "type" : "integer",
            "format" : "int64"
          },
          "releasedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "amountReleased", "id", "prisonNumber", "releasedAt", "subAccountRef" ]
      },
      "HoldBalanceResponse" : {
        "type" : "object",
        "properties" : {
          "balanceDateTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "amount" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "amount", "balanceDateTime" ]
      }
    },
    "securitySchemes" : {
      "bearer-jwt" : {
        "type" : "http",
        "description" : "A HMPPS Auth access token with either role: `[ROLE_PRISONER_FINANCE__HOLDS__RO, ROLE_PRISONER_FINANCE__HOLDS__RW]`",
        "name" : "Authorization",
        "in" : "header",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
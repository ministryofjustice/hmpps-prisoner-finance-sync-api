                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearer-jwt" : [ "ROLE_PRISONER_FINANCE__HOLDS__RW" ]
        } ]
      }
    },
    "/holds/{id}/release" : {
      "post" : {
        "tags" : [ "Holds Controller" ],
        "summary" : "Release a hold by its id",
